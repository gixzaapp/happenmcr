DATABASE_URL="postgresql://postgres:postgres@localhost:5432/happenmcr?schema=public"
PORT=4000

# Eventbrite (https://www.eventbrite.com/platform)
EVENTBRITE_API_TOKEN=""
# Optional: use organization events instead of public location search
EVENTBRITE_ORG_ID=""
EVENTBRITE_LOCATION="Manchester, UK"
EVENTBRITE_WITHIN="40km"

# Skiddle (https://www.skiddle.com/api/ — apply at https://www.skiddle.com/api/join.php)
SKIDDLE_API_KEY=""
SKIDDLE_LATITUDE="53.4808"
SKIDDLE_LONGITUDE="-2.2426"
SKIDDLE_RADIUS="15"
# Optional: YYYY-MM-DD (defaults to today)
# SKIDDLE_MIN_DATE=""

# Meetup GraphQL OAuth (https://www.meetup.com/api/oauth/list/)
MEETUP_ACCESS_TOKEN=""
MEETUP_GQL_URL="https://api.meetup.com/gql-ext"
MEETUP_LATITUDE="53.4808"
MEETUP_LONGITUDE="-2.2426"
MEETUP_RADIUS="25"
MEETUP_QUERY="Manchester"
MEETUP_CITY="Manchester"
MEETUP_COUNTRY="gb"

# Ticketmaster Discovery (https://developer.ticketmaster.com/)
TICKETMASTER_API_KEY=""
TICKETMASTER_LATITUDE="53.4808"
TICKETMASTER_LONGITUDE="-2.2426"
TICKETMASTER_RADIUS="40"
TICKETMASTER_UNIT="km"
TICKETMASTER_CITY="Manchester"
TICKETMASTER_COUNTRY_CODE="GB"

# Ingestion cron (every 10 minutes while API/worker is running)
CRON_ENABLED=true
CRON_INGEST_SCHEDULE="*/10 * * * *"
CRON_RUN_ON_START=true
CRON_STARTUP_DELAY_MS=5000

# Newsletter email encryption (AES-256-GCM). 64 hex chars = 32 bytes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEWSLETTER_ENCRYPTION_KEY=""

# Resend (https://resend.com) — required to send welcome + Thursday emails
RESEND_API_KEY=""
# After domain verify in Resend, use e.g. HappenMCR <hello@happenmcr.com>
NEWSLETTER_FROM="HappenMCR <onboarding@resend.dev>"
SITE_URL="https://happenmcr.com"
# Optional: defaults to NEWSLETTER_ENCRYPTION_KEY
# NEWSLETTER_UNSUBSCRIBE_SECRET=""
# Protects POST /newsletter/send-weekly
NEWSLETTER_SEND_SECRET=""
# Where to email new event submissions (defaults to hello@happenmcr.com)
EVENT_SUBMISSION_TO="hello@happenmcr.com"

# Object storage for event promo images (local now; set to s3 when ready)
STORAGE_DRIVER="local"
UPLOADS_DIR="./uploads"
# Public URL prefix for files (include /api when nginx proxies /api → Express)
# Local: http://localhost:4000/uploads
# Prod:  https://happenmcr.com/api/uploads
PUBLIC_UPLOADS_BASE_URL="http://localhost:4000/uploads"
