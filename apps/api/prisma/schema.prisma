generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id           String   @id @default(cuid())
  title        String
  description  String?
  startTime    DateTime @map("start_time")
  endTime      DateTime? @map("end_time")
  venueName    String?  @map("venue_name")
  venueAddress String?  @map("venue_address")
  lat          Float?
  lon          Float?
  category     String?
  tags         String[] @default([])
  source       String?
  sourceUrl    String?  @map("source_url")
  imageUrl     String?  @map("image_url")
  ticketUrl    String?  @map("ticket_url")
  isFree       Boolean  @default(false) @map("is_free")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([startTime])
  @@index([category])
  @@index([source])
  @@map("events")
}

/** Singleton row for site-wide counters (not shown on public pages). */
model SiteStat {
  id        String   @id @default("site")
  pageviews Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_stats")
}

/** Unique visitors per Europe/London calendar day (anonymous cookie). */
model DailyUniqueStat {
  day       String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("daily_unique_stats")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  emailHash      String    @unique @map("email_hash")
  emailEncrypted String    @map("email_encrypted")
  source         String?   @default("homepage")
  createdAt      DateTime  @default(now()) @map("created_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")

  @@index([createdAt])
  @@map("newsletter_subscribers")
}

/** Community / organiser submitted events awaiting review. */
model EventSubmission {
  id                  String    @id @default(cuid())
  title               String
  startTime           DateTime  @map("start_time")
  venueName           String    @map("venue_name")
  description         String
  category            String   @default("Other")
  isFree              Boolean   @default(false) @map("is_free")
  ticketUrl           String?   @map("ticket_url")
  promoImageKey       String?   @map("promo_image_key")
  promoImageUrl       String?   @map("promo_image_url")
  contactEmail        String    @map("contact_email")
  status              String    @default("pending")
  reviewedAt          DateTime? @map("reviewed_at")
  reviewedBy          String?   @map("reviewed_by")
  publishedEventId    String?   @map("published_event_id")
  slackChannelId      String?   @map("slack_channel_id")
  slackMessageTs      String?   @map("slack_message_ts")
  slackNotifyStatus   String    @default("pending") @map("slack_notify_status")
  slackNotifyAttempts Int       @default(0) @map("slack_notify_attempts")
  slackNotifyLastError String?  @map("slack_notify_last_error")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([status])
  @@index([slackNotifyStatus])
  @@map("event_submissions")
}

/** Community photos for MCR on Lens. */
model LensPhoto {
  id          String   @id @default(cuid())
  imageKey    String   @map("image_key")
  imageUrl    String   @map("image_url")
  caption     String?
  description String?
  location    String?
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("lens_photos")
}

/** OAuth sign-in (Auth.js). */
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
