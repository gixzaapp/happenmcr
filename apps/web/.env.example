API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=https://happenmcr.com

# Same Postgres as apps/api (Auth.js Prisma adapter)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/happenmcr?schema=public"

# Auth.js — generate: openssl rand -base64 32
# Local dev:
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Production VPS (apps/web/.env.local):
# AUTH_URL=https://happenmcr.com
# Also set in deploy/ecosystem.config.cjs for PM2 — do NOT use localhost on the server.

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Redirect URI: http://localhost:3000/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Facebook Login (https://developers.facebook.com/apps/)
# Redirect URI: http://localhost:3000/auth/callback/facebook
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Mapbox token for MCR on Lens (geocode + map). Prefer a public (pk.) token.
# Used server-side for /geocode and passed to the Map page.
MAPBOX_ACCESS_TOKEN=

# Optional client-only override for Mapbox GL (defaults to MAPBOX_ACCESS_TOKEN).
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Google Tag Manager (leave empty to disable). Example: GTM-XXXXXXX
# Add your GA4 config tag inside this GTM container.
NEXT_PUBLIC_GTM_ID=
