API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=https://happenmcr.com

# Mapbox token for MCR on Lens (geocode + map). Prefer a public (pk.) token.
# Used server-side for /geocode and passed to the Map page.
MAPBOX_ACCESS_TOKEN=

# Optional client-only override for Mapbox GL (defaults to MAPBOX_ACCESS_TOKEN).
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Google Tag Manager (leave empty to disable). Example: GTM-XXXXXXX
# Add your GA4 config tag inside this GTM container.
NEXT_PUBLIC_GTM_ID=
